[Unit]
Description=SMC System B trend paper service (daily Donchian, journals each closed UTC day; no orders)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=smc
WorkingDirectory=/home/smc/SMC
ExecStart=/home/smc/SMC/.venv/bin/python -m sp2l --config config/server.yaml trend --log-file /home/smc/logs/trend.log
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
