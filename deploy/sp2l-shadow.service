[Unit]
Description=SP2L Shadow runner (simulated trading on the canonical journal; no real orders)
After=network-online.target postgresql.service sp2l-collector.service
Requires=postgresql.service

[Service]
Type=simple
User=sp2l
WorkingDirectory=/home/sp2l/SP2L
ExecStart=/home/sp2l/SP2L/.venv/bin/python -m sp2l --config config/server.yaml shadow --log-file /home/sp2l/logs/shadow.log
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
