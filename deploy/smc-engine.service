[Unit]
Description=SMC engine (Smart Money Concepts signals; warmup from Tabdeal history; no orders)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=smc
WorkingDirectory=/home/smc/SMC
ExecStart=/home/smc/SMC/.venv/bin/python -m sp2l --config config/server.yaml smc --log-file /home/smc/logs/smc.log
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
